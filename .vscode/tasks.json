{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pip install -r requirements.txt -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Lint (ruff)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m ruff check .",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test (pytest)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build Windows executable",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe tools/build_exe.py --clean",
      "problemMatcher": []
    },
    {
      "label": "Build Windows executable + smoke test",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe tools/build_exe.py --clean --smoke",
      "problemMatcher": []
    }
  ]
}
